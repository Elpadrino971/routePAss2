// ROUTEPASS — Configuration externe.
//
// Ce fichier sert à injecter les clés runtime (Supabase, Stripe, Mapbox)
// dans Info.plist via les Build Settings « Info.plist Values » d'Xcode.
//
// Pour l'utiliser :
//   1. Xcode → Project → Info → Configurations
//   2. Pour chaque config (Debug, Release), choisir « Config » comme base xcconfig
//      pour la cible RoutePass.
//   3. Dupliquer ce fichier en `Config.local.xcconfig` (gitignore'é) et y mettre
//      vos vraies clés. Importer cette local config en haut :
//        #include? "Config.local.xcconfig"
//
// Les clés `RP_*` sont remontées dans Info.plist via les Build Settings
// utilisateur, et lues par `Config.swift`.

// Bundle id officiel
PRODUCT_BUNDLE_IDENTIFIER = app.routepass.mobile

// Back-end Next.js (déjà déployé sur Vercel — voir branche claude/build-routepass-payment-4bNBR)
RP_API_BASE_URL = https:/$()/routepass.vercel.app

// Supabase (mêmes valeurs que .env.local de la web app)
RP_SUPABASE_URL =
RP_SUPABASE_ANON_KEY =

// Stripe (publishable key uniquement)
RP_STRIPE_PUBLISHABLE_KEY =

// Mapbox public token
RP_MAPBOX_TOKEN =

// Apple Pay
RP_APPLE_PAY_MERCHANT_ID = merchant.app.routepass.mobile
